# Set in your shell; the app does not automatically load .env files.
SKIPRO_DATA_DIR=./data
# Leave blank for offline rule templates. Set to an installed Ollama model to enable AI summaries.
SKIPRO_MODEL=
SKIPRO_OLLAMA_URL=http://127.0.0.1:11434
# Only set after deploying and reviewing public content. Local runs are noindex.
SKIPRO_PUBLIC_URL=
